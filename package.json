{
  "name": "odflens",
  "version": "0.1.0",
  "description": "Offline OpenDocument (ODT/ODS/ODP) accessibility auditor. CI-friendly, no LibreOffice, no Java.",
  "type": "module",
  "module": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "bin": {
    "odflens": "src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srivtx/odflens.git"
  },
  "homepage": "https://odflens-srivtx.vercel.app",
  "bugs": {
    "url": "https://github.com/srivtx/odflens/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "opendocument",
    "odt",
    "ods",
    "odp",
    "wcag",
    "en-301-549",
    "sarif",
    "cli",
    "bun"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun src/fixtures.ts",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "license": "MIT",
  "author": "srivtx",
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "0.8.2"
  }
}
